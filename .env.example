# Copy to .env and fill in the keys you have. Everything works offline without
# these; they unlock cloud providers, observability, and RAGAS.

# --- LLM / embedding providers ---
OPENAI_API_KEY=
COHERE_API_KEY=
# OpenRouter is OpenAI-compatible (chat only).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=raglab

# --- Web app: auth, sessions, storage ---
# Secret used to sign session JWTs. REQUIRED in production (a warning dev
# fallback is used if unset). Generate: python -c "import secrets;print(secrets.token_hex(32))"
RAGLAB_JWT_SECRET=
# SQLite file for users / tenants / conversations / documents.
RAGLAB_APP_DB=reports/raglab_app.db
# On-disk Qdrant directory for ingested document vectors (when QDRANT_URL unset).
RAGLAB_VECTOR_DIR=qdrant_storage
# Where uploaded files are stored before ingestion.
RAGLAB_UPLOAD_DIR=uploads
# Allowed CORS origins for the web app (comma-separated).
RAGLAB_CORS_ORIGINS=http://localhost:3000

# --- Frontend (web/) ---
# Base URL the Next.js BFF uses to reach this backend.
BACKEND_URL=http://localhost:8000
